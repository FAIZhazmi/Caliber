# Copy this file to .env and replace the placeholder; .env is ignored by Git.
SUPABASE_URL=https://xfazbvdakufbcqcqllqr.supabase.co/rest/v1
# Backend-only key for the ML pipeline. Never expose it in a browser or commit it.
SUPABASE_SECRET_KEY=your-secret-key

# Direct Postgres connection string for the Streamlit descriptive dashboard.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> Session pooler.
# Never commit the real value.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Local-first Ollama with an optional authenticated cloud fallback.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_MODEL=gemma4:31b
# true: use Ollama Cloud directly; false: use local Ollama first, then cloud fallback.
OLLAMA_USE_CLOUD=false
# Create at https://ollama.com/settings/keys. Never commit the real value.
OLLAMA_API_KEY=

# Optional ClickUp settings. Keep real values in .env only.
CLICKUP_API_TOKEN=pk_240227570_RP3YN234WZYY4JWAMSS1CHYK8YLV41A6
CLICKUP_LIST_ID=
# Optional hierarchy context for destination validation and dashboard links.
CLICKUP_WORKSPACE_ID=
CLICKUP_SPACE_ID=
# Optional legacy board source. Progress Tracking writes only to CLICKUP_LIST_ID.
CLICKUP_CAPA_LIST_ID=
# Kept for compatibility with the legacy two-list board; not used for task creation.
CLICKUP_CAPA_REVIEW_STATUS=to review
# This status must already exist on the configured ClickUp List.
CLICKUP_REVIEW_STATUS=to review
# Comma-separated, case-insensitive ClickUp statuses displayed as Solved on the dashboard.
CLICKUP_SOLVED_STATUSES=done,complete,closed
# For later sync, use a closed status and the IDs of two text Custom Fields.
CLICKUP_VERIFIED_STATUS=Verified
CLICKUP_VERIFIED_RCA_FIELD_ID=
CLICKUP_VERIFIED_BY_FIELD_ID=
# Optional comma-separated ClickUp member IDs; leave blank until confirmed by the team.
CLICKUP_ASSIGNEE_IDS=
CLICKUP_GROUP_ASSIGNEE_IDS=

# Temporary dashboard login: username:password pairs separated by ";"
AUTH_USERS=
